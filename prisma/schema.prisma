generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS via string fields ───

// UserType: INTERNAL | DENTIST | CLINIC
// Role: SUPER_ADMIN | LAB_MANAGER | LAB_STAFF | LAB_TECHNICIAN | CLINIC_ADMIN | CLINIC_FINANCE | DENTIST_USER
// Department: CERAMICS | APPLIANCES | DSD
// CaseStatus: NEW | REVIEWED | IN_PRODUCTION | SENT_OUTSOURCE | RECEIVED | QC | READY | DISPATCHED | COMPLETED | CANCELLED
// DentistVisibleStatus: SUBMITTED | IN_PROGRESS | OUT_FOR_DELIVERY | DELIVERED
// DeliveryStatus: PENDING | COLLECTED | IN_TRANSIT | DELIVERED | FAILED
// DeliveryMethod: COURIER | ROYAL_MAIL | HAND_DELIVERY | COLLECTION | OTHER
// InvoiceStatus: DRAFT | SENT | PAID | OVERDUE | CANCELLED
// OutsourceStatus: QUEUED | SENT | RECEIVED | RETURNED
// SupplierInvoiceStatus: UNPAID | PAID | DISPUTED
// StatementStatus: DRAFT | ISSUED | PAID
// FileDirection: INBOUND | OUTBOUND
// NotificationChannel: EMAIL | WHATSAPP | BOTH

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  userType      String   @default("INTERNAL") // INTERNAL | DENTIST | CLINIC
  role          String   @default("LAB_STAFF") // SUPER_ADMIN | LAB_MANAGER | LAB_STAFF | LAB_TECHNICIAN | CLINIC_ADMIN | CLINIC_FINANCE | DENTIST_USER
  active        Boolean  @default(true)
  lastLogin     DateTime?
  clinicId      String?
  dentistId     String?
  inviteToken   String?  @unique
  inviteExpires DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic?   @relation(fields: [clinicId], references: [id])
  dentist       Dentist?  @relation(fields: [dentistId], references: [id])

  auditLogs         AuditLog[]
  createdRemakes    Remake[]
  generatedDamas    DAMASPrescription[]
  sentMessages      EmailMessage[]   @relation("SentMessages")
  createdInvites    UserInvite[]
  uploadedFiles     CaseFile[]       @relation("UploadedFiles")
  createdDeliveries Delivery[]       @relation("CreatedDeliveries")
  haloChatMessages  HaloChatMessage[] @relation("HaloChatSender")

  @@index([clinicId])
  @@index([dentistId])
  @@index([userType])
  @@index([role])
}

model UserInvite {
  id          String   @id @default(uuid())
  email       String
  userType    String   // INTERNAL | DENTIST | CLINIC
  role        String
  clinicId    String?
  dentistId   String?
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User     @relation(fields: [createdById], references: [id])
  clinic      Clinic?  @relation(fields: [clinicId], references: [id])
  dentist     Dentist? @relation(fields: [dentistId], references: [id])
}

model Clinic {
  id              String   @id @default(uuid())
  name            String
  address         String?
  phone           String?
  email           String?
  billingName     String?
  billingAddress  String?
  billingEmail    String?
  vatNumber       String?
  paymentTermDays Int      @default(30)
  portalPassword  String?  // Custom password for clinic to access public submission forms
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dentists        Dentist[]
  cases           Case[]
  invoices        Invoice[]
  statements      Statement[]
  users           User[]
  invites         UserInvite[]
  pricingRules    PricingRule[]
  deliveries      Delivery[]
}

model Dentist {
  id                    String   @id @default(uuid())
  clinicId              String
  name                  String
  email                 String?
  phone                 String?
  gdcNumber             String?
  paymentTermDays       Int?
  portalPassword        String?  // Custom password for dentist portal login
  pricingVariationId    String?  // Which pricing variation is assigned to this dentist
  allowCeramics         Boolean  @default(true)  // Whether dentist can submit ceramic cases
  allowDsd              Boolean  @default(true)  // Whether dentist can submit DSD cases
  allowAppliances       Boolean  @default(true)  // Whether dentist can submit appliance cases
  notificationChannel   String   @default("EMAIL") // EMAIL | WHATSAPP | BOTH
  notes                 String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  cases           Case[]
  invoices        Invoice[]
  statements      Statement[]
  users           User[]
  invites         UserInvite[]
  pricingRules    PricingRule[]

  @@index([clinicId])
}

model Patient {
  id            String   @id @default(uuid())
  reference     String   @unique // Lab reference number
  firstName     String?
  lastName      String?
  initials      String?
  dob           String?  // Optional, stored as string for flexibility
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cases         Case[]
}

model Product {
  id                     String   @id @default(uuid())
  department             String   // CERAMICS | APPLIANCES | DSD
  name                   String
  sku                    String?  @unique
  description            String?
  basePrice              Float
  requiresToothCount     Boolean  @default(false)
  requiresToothSelection Boolean  @default(false)
  minTeeth               Int?     // Minimum teeth for per-tooth pricing (e.g. 4)
  additionalToothPrice   Float?   // Price per additional tooth above minimum
  parameterSchema        String?  // JSON schema for additional parameters
  turnaroundDays         Int?     // Minimum turnaround time in working days
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  caseItems             CaseItem[]
  pricingRules          PricingRule[]

  @@index([department])
}

model PricingRule {
  id            String   @id @default(uuid())
  productId     String
  clinicId      String?  // null = default
  dentistId     String?  // null = default
  variationName String?  // Name of the pricing variation (e.g. "Standard", "Premium", "Dr Smith")
  price         Float
  minTeeth      Int?     // Override minimum teeth for per-tooth pricing
  additionalToothPrice Float? // Override price per additional tooth
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
  clinic      Clinic?  @relation(fields: [clinicId], references: [id])
  dentist     Dentist? @relation(fields: [dentistId], references: [id])

  @@index([productId, dentistId, clinicId])
}

model Case {
  id            String   @id @default(uuid())
  caseNumber    String   @unique // Format: C/D/A-XX-0001 (dept letter - patient initials - sequence)
  clinicId      String
  dentistId     String
  patientId     String?
  department    String   // CERAMICS | APPLIANCES | DSD
  status        String   @default("NEW")
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueDate       DateTime // Required field
  dueAtClinic   DateTime? // When it needs to be at the clinic (typically day before dueDate)
  notes         String?
  fileUrl       String?  // File upload URL (e.g. from JotForm ZIP upload)
  source        String   @default("MANUAL") // MANUAL | WEBSITE | JOTFORM | DENTIST_PORTAL
  externalRef   String?  // External reference (Jotform ID, Monday item ID, etc.)
  isRemake      Boolean  @default(false)
  remakeReason  String?  // Dropdown reason if this is a remake
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  dentist       Dentist  @relation(fields: [dentistId], references: [id])
  patient       Patient? @relation(fields: [patientId], references: [id])

  items             CaseItem[]
  outsourceOrders   OutsourceOrder[]
  emailThreads      EmailThread[]
  invoiceLines      InvoiceLine[]
  supplierInvoices  SupplierInvoice[]
  remakes           Remake[]
  prescriptions     DAMASPrescription[]
  auditLogs         AuditLog[]
  whatsappMessages  WhatsAppMessage[]
  files             CaseFile[]
  deliveryItems     DeliveryItem[]
  haloChatMessages  HaloChatMessage[]

  @@index([clinicId])
  @@index([dentistId])
  @@index([status])
  @@index([department])
  @@index([dueDate])
  @@index([isRemake])
}

model CaseItem {
  id            String   @id @default(uuid())
  caseId        String
  productId     String?
  description   String   // Product name or custom description
  qty           Int      @default(1)
  toothNumbers  String?  // JSON array of tooth numbers
  material      String?
  shade         String?
  notes         String?
  parameters    String?  // JSON for additional parameters
  unitPrice     Float    @default(0)
  lineTotal     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])

  invoiceLines  InvoiceLine[]
  remakes       Remake[]

  @@index([caseId])
}

model ReferralCentre {
  id                  String   @id @default(uuid())
  name                String
  email               String?
  phone               String?
  address             String?
  defaultLeadTimeDays Int      @default(5)
  specialties         String?  // JSON array
  billingTerms        String?
  notes               String?
  rating              Float?   // Rating out of 10
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  outsourceOrders     OutsourceOrder[]
  supplierInvoices    SupplierInvoice[]
  pricing             ReferralCentrePricing[]
}

model ReferralCentrePricing {
  id                String   @id @default(uuid())
  referralCentreId  String
  itemName          String   // e.g. "Porcelain Veneer", "Zirconia Crown"
  itemCategory      String?  // e.g. "Ceramics", "Appliances", "DSD"
  costPerUnit       Float
  currency          String   @default("GBP")
  notes             String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  referralCentre    ReferralCentre @relation(fields: [referralCentreId], references: [id], onDelete: Cascade)

  @@unique([referralCentreId, itemName])
  @@index([referralCentreId])
  @@index([itemName])
}

model OutsourceOrder {
  id                  String   @id @default(uuid())
  caseId              String
  referralCentreId    String
  status              String   @default("QUEUED") // QUEUED | SENT | RECEIVED | RETURNED
  sentAt              DateTime?
  expectedReturnDate  DateTime? // When we expect work back at the lab
  actualReturnDate    DateTime?
  costAmount          Float?    // Cost charged by referral centre
  isPaid              Boolean   @default(false)
  paidDate            DateTime?
  trackingRef         String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  case                Case           @relation(fields: [caseId], references: [id])
  referralCentre      ReferralCentre @relation(fields: [referralCentreId], references: [id])

  @@index([caseId])
  @@index([referralCentreId])
  @@index([status])
}

model EmailThread {
  id        String   @id @default(uuid())
  caseId    String?
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case      Case?          @relation(fields: [caseId], references: [id])
  messages  EmailMessage[]

  @@index([caseId])
}

model EmailMessage {
  id          String   @id @default(uuid())
  threadId    String
  fromAddress String
  toAddress   String
  ccAddress   String?
  subject     String
  bodyHtml    String?
  bodyText    String?
  direction   String   // INBOUND | OUTBOUND
  providerId  String?  // External email provider message ID
  sentById    String?
  attachments String?  // JSON metadata for attachments
  createdAt   DateTime @default(now())

  thread      EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sentBy      User?       @relation("SentMessages", fields: [sentById], references: [id])

  @@index([threadId])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  bodyHtml  String
  bodyText  String?
  variables String?  // JSON array of variable names
  category  String?  // outsource | update | general | whatsapp
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceNo   String   @unique
  clinicId    String
  dentistId   String?
  periodStart DateTime?
  periodEnd   DateTime?
  status      String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | CANCELLED
  subtotal    Float    @default(0)
  vatRate     Float    @default(0)
  vatAmount   Float    @default(0)
  total       Float    @default(0)
  dueDate     DateTime?
  paidDate    DateTime?
  pdfUrl      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  dentist     Dentist? @relation(fields: [dentistId], references: [id])
  lines       InvoiceLine[]

  @@index([clinicId])
  @@index([dentistId])
  @@index([status])
}

model InvoiceLine {
  id              String   @id @default(uuid())
  invoiceId       String
  caseId          String?
  caseItemId      String?
  description     String
  qty             Int      @default(1)
  unitPrice       Float
  total           Float
  toothCount      Int?     // Number of teeth for per-tooth pricing
  additionalTeeth Int?     // Number of additional teeth above minimum
  createdAt       DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  case        Case?    @relation(fields: [caseId], references: [id])
  caseItem    CaseItem? @relation(fields: [caseItemId], references: [id])

  @@index([invoiceId])
}

model SupplierInvoice {
  id                String   @id @default(uuid())
  referralCentreId  String
  caseId            String?
  supplierInvoiceNo String
  status            String   @default("UNPAID") // UNPAID | PAID | DISPUTED
  amount            Float
  vatAmount         Float    @default(0)
  total             Float
  date              DateTime
  dueDate           DateTime?
  paidDate          DateTime?
  paidAmount        Float?    // Actual amount paid
  attachmentUrl     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  referralCentre    ReferralCentre @relation(fields: [referralCentreId], references: [id])
  case              Case?          @relation(fields: [caseId], references: [id])

  @@index([referralCentreId])
  @@index([caseId])
  @@index([status])
}

model Statement {
  id          String   @id @default(uuid())
  clinicId    String
  dentistId   String?
  periodStart DateTime
  periodEnd   DateTime
  totalDue    Float    @default(0)
  status      String   @default("DRAFT") // DRAFT | ISSUED | PAID
  pdfUrl      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  dentist     Dentist? @relation(fields: [dentistId], references: [id])

  @@index([clinicId])
  @@index([dentistId])
}

model Remake {
  id            String   @id @default(uuid())
  caseId        String
  caseItemId    String?
  reasonCode    String   // MATERIAL_DEFECT | FIT_ISSUE | SHADE_MISMATCH | BREAKAGE | DESIGN_ERROR | IMPRESSION_ISSUE | WRONG_SHADE | OTHER
  reasonText    String?
  costEstimate  Float?
  createdById   String
  createdAt     DateTime @default(now())

  case          Case     @relation(fields: [caseId], references: [id])
  caseItem      CaseItem? @relation(fields: [caseItemId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([caseId])
  @@index([reasonCode])
}

model DAMASPrescription {
  id              String   @id @default(uuid())
  caseId          String
  version         Int      @default(1)
  generatedById   String
  structuredData  String   // JSON
  pdfUrl          String?
  generatedAt     DateTime @default(now())

  case            Case @relation(fields: [caseId], references: [id])
  generatedBy     User @relation(fields: [generatedById], references: [id])

  @@index([caseId])
}

model CaseFile {
  id                String   @id @default(uuid())
  caseId            String
  fileName          String
  fileType          String   // stl | html | pdf | image | other
  fileUrl           String   // URL or path to the file
  fileSize          Int?     // Size in bytes
  description       String?
  direction         String   @default("INBOUND") // INBOUND | OUTBOUND
  uploadedById      String?
  sharedWithDentist Boolean  @default(false)
  dentistNotified   Boolean  @default(false) // Whether dentist was notified about this file
  createdAt         DateTime @default(now())

  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy  User?    @relation("UploadedFiles", fields: [uploadedById], references: [id])

  @@index([caseId])
  @@index([direction])
}

model Delivery {
  id              String   @id @default(uuid())
  deliveryNumber  String   @unique // e.g. DEL-2026-0001
  clinicId        String
  status          String   @default("PENDING") // PENDING | COLLECTED | IN_TRANSIT | DELIVERED | FAILED
  method          String   @default("COURIER") // COURIER | ROYAL_MAIL | HAND_DELIVERY | COLLECTION | OTHER
  trackingRef     String?
  driverName      String?
  notes           String?
  estimatedDate   DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  createdBy       User?    @relation("CreatedDeliveries", fields: [createdById], references: [id])
  items           DeliveryItem[]

  @@index([clinicId])
  @@index([status])
  @@index([dispatchedAt])
  @@index([createdAt])
}

model DeliveryItem {
  id          String   @id @default(uuid())
  deliveryId  String
  caseId      String
  createdAt   DateTime @default(now())

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  case        Case     @relation(fields: [caseId], references: [id])

  @@unique([deliveryId, caseId])
  @@index([deliveryId])
  @@index([caseId])
}

model AuditLog {
  id          String   @id @default(uuid())
  caseId      String?
  userId      String?
  action      String   // STATUS_CHANGE | CREATED | UPDATED | DELETED | EMAIL_SENT | INVOICE_GENERATED etc.
  entityType  String?  // Case, Invoice, OutsourceOrder, etc.
  entityId    String?
  oldValue    String?  // JSON
  newValue    String?  // JSON
  ipAddress   String?
  createdAt   DateTime @default(now())

  case        Case? @relation(fields: [caseId], references: [id])
  user        User? @relation(fields: [userId], references: [id])

  @@index([caseId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model DepartmentStatusConfig {
  id                    String  @id @default(uuid())
  department            String  // CERAMICS | APPLIANCES | DSD
  statuses              String  // JSON array of ordered statuses
  dentistVisibleStatuses String? // JSON array of statuses visible to dentists
  active                Boolean @default(true)

  @@unique([department])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String?
  category  String   @default("general") // general | billing | branding | integrations | notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppMessage {
  id            String   @id @default(uuid())
  contactName   String
  contactPhone  String
  direction     String   // INBOUND | OUTBOUND
  messageType   String   @default("text") // text | image | document
  content       String
  waMessageId   String?  // WhatsApp message ID
  status        String   @default("sent") // sent | delivered | read | failed
  caseId        String?
  createdAt     DateTime @default(now())

  case          Case?    @relation(fields: [caseId], references: [id])

  @@index([contactPhone])
  @@index([caseId])
  @@index([createdAt])
}

// HaloChat - Internal messaging between dentist portal and lab
model HaloChatMessage {
  id          String   @id @default(uuid())
  caseId      String?
  senderId    String
  senderType  String   // DENTIST | INTERNAL
  message     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  case        Case?    @relation(fields: [caseId], references: [id])
  sender      User     @relation("HaloChatSender", fields: [senderId], references: [id])

  @@index([caseId])
  @@index([senderId])
  @@index([createdAt])
}

// Notification automation rules
model NotificationRule {
  id          String   @id @default(uuid())
  name        String
  trigger     String   // STATUS_CHANGE | CASE_CREATED | FILE_SHARED | PRESCRIPTION_READY | REMAKE_FLAGGED
  triggerValue String? // e.g. specific status value
  channel     String   // EMAIL | WHATSAPP | BOTH
  templateId  String?  // Optional email template
  recipient   String   // DENTIST | CLINIC | LAB
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// WhatsApp message templates
model WhatsAppTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String   // Template text with {{variables}}
  variables String?  // JSON array of variable names
  category  String?  // status_update | case_notification | delivery | general
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
